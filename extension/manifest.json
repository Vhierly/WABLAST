{
  "manifest_version": 3,
  "name": "WAsender Pro Helper",
  "version": "2.1",
  "description": "Advanced Auto-Send Helper for J&T Cargo WAsender",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "*://*.run.app/*",
    "*://*.netlify.app/*",
    "*://*.netlify.com/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.run.app/*",
        "*://*.netlify.app/*",
        "*://*.netlify.com/*",
        "http://localhost:*/*",
        "https://localhost:*/*"
      ],
      "js": ["detector.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
